<UserControl xmlns="https://github.com/avaloniaui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="using:Monetria.ViewModels" 
             mc:Ignorable="d" x:Class="Monetria.Views.DashboardPageView"
             x:DataType="vm:DashboardPageViewModel">
    
    <ScrollViewer>
        <StackPanel Spacing="15" Margin="10" Orientation="Vertical">

            <TextBlock Text="Bem vindo ao Dashboard!" FontSize="20" FontWeight="Bold"/>
            <TextBox BorderThickness="0" TextWrapping="Wrap">
                ASDKAKLDKALJDKLAJDLKAJDK
            </TextBox>

            <!-- Gráfico de Pizza com borda arredondada -->
            <Border CornerRadius="15" 
                    BorderThickness="2" 
                    BorderBrush="Black" 
                    Background="Black"
                    Padding="10"
                    Margin="0,10,0,0">
                <lvc:PieChart Series="{Binding PieSeries}" 
                              LegendPosition="Left" 
                              Height="420"/>
            </Border>

            <!-- Gráfico de Linha com borda arredondada -->
            <Border CornerRadius="15" 
                    BorderThickness="2" 
                    BorderBrush="Black" 
                    Background="Black"
                    Padding="10"
                    Margin="0,10,0,0">
                <lvc:CartesianChart Series="{Binding LineSeries}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    Height="450"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>