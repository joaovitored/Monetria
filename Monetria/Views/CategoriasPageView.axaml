<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Monetria.ViewModels"
             xmlns:models="using:Monetria.Models"
             x:Class="Monetria.Views.CategoriasPageView"
             x:DataType="vm:CategoriasPageViewModel">

    <StackPanel Margin="10" Spacing="10">

        <TextBlock Text="Categories"
                   FontSize="20"
                   FontWeight="Bold"/>

        <!--  Filtro -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Filter by type:"
                       VerticalAlignment="Center"/>

            <ComboBox Width="160"
                      ItemsSource="{Binding TiposFiltro}"
                      SelectedItem="{Binding FiltroTipo, Mode=TwoWay}" />
        </StackPanel>

        <!--  Grid das categorias -->
        <DataGrid ItemsSource="{Binding Categorias}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  RowDetailsVisibilityMode="VisibleWhenSelected">

            <DataGrid.Columns >

                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Nome}"
                                    Width="*" />

                <DataGridTextColumn Header="Type"
                                    Binding="{Binding Tipo}"
                                    Width="120"/>

                
                <DataGridTextColumn Header="Total"
                                    Binding="{Binding TotalFormatado}"
                                    Width="140"/>

                <DataGridTemplateColumn Header="Color" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="14"
                                    Height="14"
                                    Background="{Binding Cor}"
                                    CornerRadius="7"
                                    HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

            <!-- Detalhes das transações -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate x:DataType="models:Categoria">

                    <Border Margin="10"
                            Padding="10"
                            BorderThickness="1"
                            BorderBrush="LightGray"
                            CornerRadius="6">

                        <DataGrid ItemsSource="{Binding Transacoes}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalScrollBarVisibility="Disabled">  <!-- Adicionado para remover barra horizontal -->

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Data"
                                                    Binding="{Binding Data, StringFormat='{}{0:dd/MM/yyyy}'}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Tipo"
                                                    Binding="{Binding Tipo}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Descrição"
                                                    Binding="{Binding Descricao}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Valor"
                                                    Binding="{Binding ValorFormatado}"
                                                    Width="120"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

        </DataGrid>

    </StackPanel>
</UserControl>